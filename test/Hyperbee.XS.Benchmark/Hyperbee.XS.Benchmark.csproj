<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plural, with one value: Directory.Build.props sets <TargetFrameworks>,
         which overrides the singular form, so this has to match in kind.
         Benchmarks run on one modern runtime; netstandard2.1 is not a runtime. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="FastExpressionCompiler" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hyperbee.XS\Hyperbee.XS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" />
  </ItemGroup>

</Project>

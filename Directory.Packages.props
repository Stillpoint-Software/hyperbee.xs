<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="FastExpressionCompiler" Version="6.0.0" />
    <PackageVersion Include="Hyperbee.Collections" Version="2.8.2" />
    <PackageVersion Include="Hyperbee.Expressions" Version="1.7.3" />
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94">
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <!-- Core Libraries -->
    <!--
      Held at 1.3.6. Parlot 2.x is a breaking change to the fluent parser surface:
      And/Then tuple shapes differ, the two-argument ZeroOrOne overload is gone and
      Scanner.ReadIdentifier is obsolete. Moving XsParser to it is a migration of its
      own and is out of scope for a targeting change.
    -->
    <PackageVersion Include="Parlot" Version="1.3.6" />
    <!--
      Build-time only: PolySharp is a source generator. Every project references it
      with PrivateAssets="all", so it never appears in this repository's package
      dependencies. See Directory.Build.props for what it generates and why.
    -->
    <PackageVersion Include="PolySharp" Version="1.17.1" />
    <!--
      NuGet Libraries. 7.9.0 ships lib/net472 and lib/net8.0 only, with no
      netstandard asset, which is why Hyperbee.XS compiles its package-loading
      surface out of the netstandard2.1 build. See src/Hyperbee.XS/Core/ReferenceManager.cs.
    -->
    <PackageVersion Include="NuGet.Configuration" Version="8.0.0" />
    <PackageVersion Include="NuGet.DependencyResolver.Core" Version="8.0.0" />
    <PackageVersion Include="NuGet.Packaging" Version="8.0.0" />
    <PackageVersion Include="NuGet.ProjectModel" Version="8.0.0" />
    <PackageVersion Include="NuGet.Protocol" Version="8.0.0" />
    <!-- CLI Libraries -->
    <PackageVersion Include="Spectre.Console" Version="0.50.0" />
    <PackageVersion Include="Spectre.Console.Cli" Version="0.50.0" />
    <!-- Testing Libraries -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.3" />
  </ItemGroup>
  <!--
    Runtime-aligned packages, pinned per target. Only the tooling, CLI, interactive
    and test projects consume these, and all of them are pinned to net11.0;net10.0,
    so there is no netstandard2.1 block here.

    A condition on $(TargetFramework) works in this file only because every project
    that reaches it cross-targets; it is still the wrong place for a netstandard2.1
    pin, because Microsoft.Common.props imports this file before TargetFramework
    exists during the outer, framework-less evaluation. netstandard2.1 version pins
    belong on the PackageReference as VersionOverride in the csproj.
  -->
  <!-- .NET 10 specific package versions -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.15" />
    <!--
      Pinned to patch GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7 in
      System.Security.Cryptography.Pkcs 8.0.1, which the NuGet client stack still
      depends on at 8.0.0. The assembly is in box on net10.0 and net11.0, so this
      only moves the restore graph off the vulnerable version.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <!--
      11.0.0, not 10.0.x: Hyperbee.Expressions 1.6.0 requires
      Microsoft.Extensions.DependencyInjection >= 11.0.0 on its net10.0 asset too,
      and a 10.0.x pin here is a downgrade that fails restore with NU1605. The
      11.0.0 package ships lib/net10.0, so the net10.0 build is unaffected.
    -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="10.0.15" />
    <PackageVersion Include="Microsoft.CodeAnalysis" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Scripting.Common" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces" Version="5.0.0" />
    <PackageVersion Include="Microsoft.DotNet.Interactive" Version="1.0.0-beta.26120.1" />
    <PackageVersion Include="Microsoft.DotNet.Interactive.CSharp" Version="1.0.0-beta.26120.1" />
    <PackageVersion Include="Microsoft.DotNet.Interactive.Formatting" Version="1.0.0-beta.26120.1" />
    <PackageVersion Include="Microsoft.DotNet.Interactive.PackageManagement" Version="1.0.0-beta.26120.1" />
  </ItemGroup>
  <!-- .NET 11 specific package versions -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="11.0.0" />
    <!-- See the net10.0 block for why Pkcs is pinned. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="11.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Scripting.Common" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces" Version="5.0.0" />
    <PackageVersion Include="Microsoft.DotNet.Interactive" Version="1.0.0-beta.26120.1" />
    <PackageVersion Include="Microsoft.DotNet.Interactive.CSharp" Version="1.0.0-beta.26120.1" />
    <PackageVersion Include="Microsoft.DotNet.Interactive.Formatting" Version="1.0.0-beta.26120.1" />
    <PackageVersion Include="Microsoft.DotNet.Interactive.PackageManagement" Version="1.0.0-beta.26120.1" />
  </ItemGroup>
</Project>
